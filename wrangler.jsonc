{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payments-do",
  "account_id": "b6641681fe423910342b9ffa1364c76d",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "preview_urls": false,

  "routes": [
    {
      "pattern": "payments.do/*",
      "zone_name": "payments.do",
    },
  ],

  "services": [
    { "binding": "EVENTS", "service": "events", "entrypoint": "EventsService" }
  ],

  // Vin estate checkout (vin platform-wiring ADR PW-5; vin beads vin-zik).
  // Secrets are FOUNDER acts on the deployed Worker — never committed here:
  //   wrangler secret put STRIPE_SECRET_KEY       (PW-5 step 1)
  //   wrangler secret put STRIPE_WEBHOOK_SECRET   (PW-5 step 1; from the
  //     Stripe dashboard webhook endpoint https://payments.do/webhooks,
  //     event: checkout.session.completed)
  //   wrangler secret put VIN_SETTLE_TOKEN        (bearer for the vin ledger forward)
  // The vin estate's settlement-confirm endpoint landed (vin-c2p.21,
  // vin repo commit ae77fef): POST all.vin/_settle. Until all.vin DNS +
  // the estate's LEDGER binding land, the forward fails loudly (500 to
  // Stripe) and settlements replay via Stripe redelivery — by design
  // (vin activation runbook §3).
  // REHEARSAL (2026-07-24, vin TEST-DOLLAR rehearsal): pointed at the estate
  // Worker's workers.dev demo host while all.vin routes are unapplied. The
  // ?__host=all.vin override satisfies the settle handler's host gate
  // (DEMO=1 deploy). MUST flip back to https://all.vin/_settle after the
  // founder's route apply (vin docs/ops/payments-do-activation-runbook.md).
  "vars": { "VIN_SETTLE_URL": "https://vin-site.dotdo.workers.dev/_settle?__host=all.vin" },
}
