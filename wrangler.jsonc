{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payments-do",
  "account_id": "b6641681fe423910342b9ffa1364c76d",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "preview_urls": false,

  "routes": [
    {
      "pattern": "payments.do/*",
      "zone_name": "payments.do",
    },
  ],

  "services": [
    { "binding": "EVENTS", "service": "events", "entrypoint": "EventsService" }
  ],

  // Vin estate checkout (vin platform-wiring ADR PW-5; vin beads vin-zik).
  // Secrets are FOUNDER acts on the deployed Worker — never committed here:
  //   wrangler secret put STRIPE_SECRET_KEY       (PW-5 step 1)
  //   wrangler secret put STRIPE_WEBHOOK_SECRET   (PW-5 step 1; from the
  //     Stripe dashboard webhook endpoint https://payments.do/webhooks,
  //     event: checkout.session.completed)
  //   wrangler secret put VIN_SETTLE_TOKEN        (bearer for the vin ledger forward)
  // Uncomment once the vin estate's settlement-confirm endpoint exists;
  // unset, the webhook skips the forward and the events pipeline still
  // carries the raw Stripe event:
  // "vars": { "VIN_SETTLE_URL": "https://all.vin/_settle" },
}
